<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sutil resplandor circular de dispersión estelar -->
    <path
        android:fillColor="#2200F0FF"
        android:pathData="M 54,54 m -18,0 a 18,18 0 1,1 36,0 a 18,18 0 1,1 -36,0" />

    <!-- Corchete izquierdo '<' (Supernova Cyan #00f0ff) -->
    <path
        android:pathData="M 35,36 L 25,54 L 35,72"
        android:strokeWidth="3.5"
        android:strokeColor="#00F0FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Corchete derecho '>' (Supernova Cyan #00f0ff) -->
    <path
        android:pathData="M 73,36 L 83,54 L 73,72"
        android:strokeWidth="3.5"
        android:strokeColor="#00F0FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Estrella '✦' central en Stellar Violet (#8b5cf6) con puntas armónicas -->
    <path
        android:pathData="M 54,32 Q 52,52 32,54 Q 52,56 54,76 Q 56,56 76,54 Q 56,52 54,32 Z"
        android:fillColor="#8B5CF6" />

    <!-- Núcleo brillante en Supernova Cyan (#00f0ff) -->
    <path
        android:pathData="M 54,43 Q 53,53 43,54 Q 53,55 54,65 Q 55,55 65,54 Q 55,53 54,43 Z"
        android:fillColor="#00F0FF" />

    <!-- Punto central de ignición estelar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,54 m -2.5,0 a 2.5,2.5 0 1,1 5,0 a 2.5,2.5 0 1,1 -5,0" />

</vector>
